# Security & Debugging
SECRET_KEY=django-insecure-dev-key-change-in-production-only-for-local-testing
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Set DB_ENGINE to 'postgresql' to connect to remote Postgres, or 'sqlite' for local fallback
DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=your_remote_host_here
DB_PORT=5432
